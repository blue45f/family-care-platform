FROM node:22-alpine AS deps

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web-app/package.json ./apps/web-app/package.json
COPY apps/api-server/package.json ./apps/api-server/package.json

RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --dir apps/web-app run build

FROM node:22-alpine

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web-app/package.json /app/package.json
COPY --from=deps /app/apps/web-app/dist ./apps/web-app/dist

WORKDIR /app/apps/web-app

EXPOSE 4173
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4173

CMD ["pnpm", "run", "start", "--", "--host", "0.0.0.0", "--port", "4173"]
