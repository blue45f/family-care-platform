FROM node:22-alpine AS deps

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/api/package.json ./apps/api/package.json

RUN pnpm install --frozen-lockfile

COPY . .

# 브라우저 번들에 박히는 빌드 타임 API 주소. compose/배포에서 --build-arg로 주입한다.
# 미지정 시 apps/web/src/api.ts의 기본값(prod: 상대경로 "/api")을 사용한다.
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

RUN pnpm --dir apps/web run build

FROM node:22-alpine

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/package.json /app/package.json
COPY --from=deps /app/apps/web/dist ./apps/web/dist

WORKDIR /app/apps/web

EXPOSE 4173
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4173

CMD ["pnpm", "run", "start", "--", "--host", "0.0.0.0", "--port", "4173"]
