NODE_ENV=production
PORT=3001

# CORS 허용 도메인(쉼표로 구분). 예: https://app.your-domain.com,https://admin.your-domain.com
# 운영 환경에서는 필수로 설정하세요.
CORS_ALLOWED_ORIGINS=https://app.your-domain.com

# 프론트에서 API 호출 시 사용할 주소(빌드 시점 환경변수)
VITE_API_URL=http://localhost:3001/api

# 스크립트용 API(브라우저 스모크 테스트)
FAMILY_CARE_API_URL=http://localhost:3001/api

# SurveyDesk 피드백 위젯 엔드포인트(설정 시에만 위젯이 마운트됨; 미설정이면 비활성)
# VITE_SURVEYDESK_URL=https://surveys.your-domain.com

# ── DeskCloud 위젯(각 URL 설정 시에만 마운트; 미설정이면 비활성) ──
# ChangelogDesk: 변경 이력('What's new') 벨(글로벌 헤더/셸)
# VITE_CHANGELOGDESK_URL=https://changelog.your-domain.com
# VITE_CHANGELOGDESK_PK=pk_demo
# NotifyDesk: 알림 인박스 벨(글로벌 헤더/셸)
# VITE_NOTIFYDESK_URL=https://notify.your-domain.com
# VITE_NOTIFYDESK_PK=pk_demo
# SearchDesk: ⌘K 검색 팔레트(글로벌 단축키)
# VITE_SEARCHDESK_URL=https://search.your-domain.com
# VITE_SEARCHDESK_PK=pk_demo
# ChatDesk: 쪽지·채팅 위젯(플로팅 런처)
# VITE_CHATDESK_URL=https://chat.your-domain.com
# VITE_CHATDESK_PK=pk_demo
# MediaDesk: 미디어 업로더·갤러리(플로팅 런처)
# VITE_MEDIADESK_URL=https://media.your-domain.com
# VITE_MEDIADESK_PK=pk_demo
