NODE_ENV=production
PORT=3001

# CORS 허용 도메인(쉼표로 구분). 예: https://app.your-domain.com,https://admin.your-domain.com
# 운영 환경에서는 필수로 설정하세요.
CORS_ALLOWED_ORIGINS=https://app.your-domain.com

# 프론트에서 API 호출 시 사용할 주소(빌드 시점 환경변수)
VITE_API_URL=http://localhost:3001/api

# 스크립트용 API(브라우저 스모크 테스트)
FAMILY_CARE_API_URL=http://localhost:3001/api

# ── DeskCloud 네이티브 연동(env-gated) ──────────────────────────────────────
# 발행된 npm SDK @heejun/deskcloud 의 브라우저(pk_) 클라이언트로 데이터만 가져와
# 이 앱의 컴포넌트·디자인 토큰으로 렌더한다(위젯 임베드/외부 CSS 없음 — TermsDesk 방식).
# 각 Desk 는 자기 VITE_*DESK_URL 이 설정된 경우에만 활성화된다(미설정=1차 기능 폴백).
# PK(VITE_*DESK_PK)는 브라우저 노출이 안전한 공개 키다(없으면 'pk_demo' 폴백).
# secret(sk_) 키는 클라이언트 코드/이 파일에 절대 두지 않는다.
# 아래 URL 은 라이브 DeskCloud 인스턴스 예시 — 운영 빌드에서 환경 변수로 주입한다.

# SurveyDesk: 인앱 피드백/설문 런처(1차 기능, main.tsx 마운트)
# VITE_SURVEYDESK_URL=https://surveydesk-api.vercel.app

# ChangelogDesk: 가이드 페이지의 '서비스 업데이트' 네이티브 카드(발행 변경 이력 읽기)
# VITE_CHANGELOGDESK_URL=https://changelogdesk-api.vercel.app
# VITE_CHANGELOGDESK_PK=pk_demo
# NotifyDesk: 대시보드의 '최근 알림' 네이티브 카드(인박스 읽기 + 읽음 처리, 로그인 한정)
# VITE_NOTIFYDESK_URL=https://notifydesk-api.vercel.app
# VITE_NOTIFYDESK_PK=pk_demo
# SearchDesk: 네이티브 ⌘K 검색 팔레트(앱 디자인 토큰으로 렌더)
# VITE_SEARCHDESK_URL=https://searchdesk-api.vercel.app
# VITE_SEARCHDESK_PK=pk_demo

# ── 의도적으로 연결하지 않은 DeskCloud 모듈 ─────────────────────────────────
# 아래 모듈들은 이 앱의 CORE/차별화 기능과 중복되므로 네이티브로도 붙이지 않는다.
# (제네릭 유틸만 Desk 로 교체하는 원칙 — 핵심 기능은 보존):
#  - CommunityDesk  → 자체 커뮤니티 게시판(/community, 백엔드 API·첨부·모더레이션)이 핵심.
#  - ReviewDesk     → 돌봄 후기는 커뮤니티 '간병후기' 카테고리로 운영(별도 평점벽 불필요).
#  - ModerationDesk → 관리자 글 숨김/삭제가 커뮤니티에 내장(핵심 운영 동작).
#  - RealtimeDesk   → 상담/쪽지 폴링이 도메인 핵심(별도 프레즌스 불필요).
#  - ChatDesk       → 1:1 쪽지/상담(/messages·/support)이 백엔드 1차 기능으로 존재.
#  - MediaDesk      → 커뮤니티 첨부 업로드가 1차 기능(별도 미디어 런처 불필요).
