FROM node:24-alpine AS deps

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared/package.json ./packages/shared/package.json

# 루트 postinstall(shared tsup 빌드)은 이 단계에 소스가 없어 실패한다 —
# 스크립트는 건너뛰고 shared 는 아래에서 소스 복사 후 명시적으로 빌드한다.
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .
# shared 는 런타임 require 대상(main: dist/index.cjs)이라 api 보다 먼저 빌드해야 한다.
RUN pnpm --dir packages/shared run build && pnpm --dir apps/api run build

FROM node:24-alpine AS runtime

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api ./apps/api
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=deps /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001
CMD ["node", "apps/api/dist/src/main.js"]
