{
  "name": "family-care-operations-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false --noEmit",
